{
  "name": "specnico",
  "version": "2.1.1",
  "description": "Fluxo spec-driven para Claude Code: constituição, specs, gate humano e execução em ondas.",
  "bin": {
    "specnico": "bin/cli.js"
  },
  "scripts": {
    "test": "node --test \"meta/tests/*.test.mjs\"",
    "check:docs": "node meta/tests/lint-docs.mjs",
    "check:eol": "node meta/tests/check-eol.mjs",
    "check:package": "node meta/tests/check-maintenance.mjs",
    "check": "npm run check:package && npm run check:eol && npm run check:docs && npm test",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "bin",
    ".claude/agents",
    ".claude/hooks",
    ".claude/skills",
    ".claude/CLAUDE.md",
    ".claude/README.md",
    ".claude/settings.example.json",
    ".specify/templates",
    ".specify/packs",
    ".specify/workflows",
    ".specify/memory",
    "specs/README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertourias/scaffold-ia-projetos.git"
  },
  "homepage": "https://github.com/robertourias/scaffold-ia-projetos#readme",
  "bugs": {
    "url": "https://github.com/robertourias/scaffold-ia-projetos/issues"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "scaffold",
    "harness",
    "spec-driven",
    "spec-kit",
    "sdd"
  ],
  "publishConfig": {
    "access": "public"
  }
}
