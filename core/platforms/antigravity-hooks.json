{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.specify/hooks/adapters/gemini-hook.mjs spec-gate",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.specify/hooks/adapters/gemini-hook.mjs verify-file",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
